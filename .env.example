# Live Netezza tests (JustyBase.NetezzaDriver).
# Copy to .env and export the values, or set them in your shell.
# The password is never committed and never has a code default.

NZ_DEV_HOST=127.0.0.1
NZ_DEV_PORT=5480
NZ_DEV_DB=JUST_DATA
NZ_DEV_USER=admin
NZ_DEV_PASSWORD=

# Optional: allow the old lab defaults (admin/password) when the values above
# are absent. Do not enable this in CI.
# NZ_DEV_ALLOW_LAB_DEFAULTS=0

# Optional: database used by ChangeDatabase tests.
# NZ_DEV_CHANGE_DB=SYSTEM
